# cp .env.local.example .env.local and fill in your key.
# .env.local is gitignored and is resolved against this repo's root, not the
# directory cici is launched in.
ANTHROPIC_API_KEY=sk-ant-...

# CICI_DEBUG=1   # dump the full message array after every turn
# CICI_YOLO=1    # skip the confirmation prompt on shell commands
